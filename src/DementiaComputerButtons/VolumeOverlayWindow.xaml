<Window x:Class="DementiaComputerButtons.VolumeOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="760" Height="155" WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" ShowInTaskbar="False" ShowActivated="False"
        Topmost="True" ResizeMode="NoResize" Focusable="False">
    <Border Background="#E6111820" CornerRadius="18" Padding="28,18" BorderBrush="#CCFFFFFF" BorderThickness="2">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Grid Margin="2,0,2,12">
                <TextBlock x:Name="MuteText" Text="VOLUME" Foreground="White" FontSize="25" FontWeight="Bold"/>
                <TextBlock x:Name="PercentText" Text="50%" Foreground="White" FontSize="30" FontWeight="Bold" HorizontalAlignment="Right"/>
            </Grid>
            <Grid x:Name="VolumeBar" Grid.Row="1" Height="42">
                <Border Background="#FF303B45" CornerRadius="8"/>
                <Grid Margin="5">
                    <Grid.ColumnDefinitions><ColumnDefinition x:Name="FilledColumn" Width="50*"/><ColumnDefinition x:Name="EmptyColumn" Width="50*"/></Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="#FF4FC3F7" CornerRadius="5"/>
                </Grid>
            </Grid>
            <TextBlock x:Name="StatusDetailText" Grid.Row="1" Visibility="Collapsed" Foreground="#FFE3F2FD"
                       FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            <Grid x:Name="AudioRoutePanel" Grid.RowSpan="2" Visibility="Collapsed">
                <Grid.RowDefinitions><RowDefinition Height="220"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Viewbox x:Name="SpeakerIcon" Width="210" Height="190" HorizontalAlignment="Center">
                    <Canvas Width="140" Height="120">
                        <Path Fill="White" Data="M12,45 L42,45 L75,18 L75,102 L42,75 L12,75 Z"/>
                        <Path Stroke="White" StrokeThickness="8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="Transparent" Data="M91,43 C105,53 105,67 91,77"/>
                        <Path Stroke="White" StrokeThickness="8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="Transparent" Data="M107,27 C134,46 134,74 107,93"/>
                    </Canvas>
                </Viewbox>
                <Viewbox x:Name="HeadphonesIcon" Width="220" Height="190" HorizontalAlignment="Center">
                    <Canvas Width="140" Height="120">
                        <Path Stroke="White" StrokeThickness="10" StrokeStartLineCap="Round" Fill="Transparent" Data="M20,67 C20,13 120,13 120,67"/>
                        <Rectangle Canvas.Left="12" Canvas.Top="60" Width="27" Height="48" RadiusX="9" RadiusY="9" Fill="White"/>
                        <Rectangle Canvas.Left="101" Canvas.Top="60" Width="27" Height="48" RadiusX="9" RadiusY="9" Fill="White"/>
                    </Canvas>
                </Viewbox>
                <TextBlock x:Name="AudioRouteText" Grid.Row="1" Foreground="White" FontSize="34" FontWeight="Bold"
                           HorizontalAlignment="Center" TextAlignment="Center"/>
            </Grid>
        </Grid>
    </Border>
</Window>

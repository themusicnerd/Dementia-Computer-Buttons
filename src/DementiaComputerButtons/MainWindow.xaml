<Window x:Class="DementiaComputerButtons.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Dementia Computer Buttons: Engineering Diagnostics" Height="860" Width="1120" MinHeight="700" MinWidth="900" Background="#F2F4F7" Icon="Assets/DementiaComputerButtons.ico">
  <Window.Resources>
    <Style TargetType="GroupBox"><Setter Property="Margin" Value="6"/><Setter Property="Padding" Value="10"/></Style>
    <Style TargetType="Button"><Setter Property="Margin" Value="4"/><Setter Property="Padding" Value="12,7"/><Setter Property="MinWidth" Value="78"/></Style>
    <Style TargetType="TextBlock"><Setter Property="VerticalAlignment" Value="Center"/></Style>
    <Style TargetType="TabItem"><Setter Property="Padding" Value="15,8"/><Setter Property="FontSize" Value="14"/></Style>
    <Style x:Key="PanelLightButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Opacity" Value="0.55"/><Setter Property="BorderBrush" Value="#66727D"/><Setter Property="BorderThickness" Value="2"/><Style.Triggers><Trigger Property="Tag" Value="True"><Setter Property="Opacity" Value="1"/><Setter Property="BorderBrush" Value="#FFFF66"/><Setter Property="BorderThickness" Value="5"/></Trigger></Style.Triggers></Style>
  </Window.Resources>
  <Grid Margin="10">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Border Background="#1C2B39" CornerRadius="6" Padding="14" Margin="6"><DockPanel><StackPanel><TextBlock Text="Dementia Computer Buttons" Foreground="White" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="Engineering console: DCB/1" Foreground="#BFD4E5"/></StackPanel><StackPanel DockPanel.Dock="Right" HorizontalAlignment="Right"><TextBlock Text="{Binding ConnectionStatus}" Foreground="#80E6A7" FontSize="17" FontWeight="Bold"/><TextBlock Text="{Binding OperationStatus}" Foreground="White" TextTrimming="CharacterEllipsis" MaxWidth="520"/></StackPanel></DockPanel></Border>
    <TabControl Grid.Row="1" Margin="6">
      <TabItem Header="Console"><ScrollViewer VerticalScrollBarVisibility="Auto"><Grid Margin="6"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
        <GroupBox Header="Physical console: clickable preview"><UniformGrid Rows="3" Columns="3" HorizontalAlignment="Center">
          <Button Style="{StaticResource PanelLightButton}" Tag="{Binding VolumeDownLightOn}" Background="White" Foreground="#17202A" Command="{Binding ConsoleActionCommand}" CommandParameter="PANEL_1"><StackPanel><TextBlock Text="−" FontSize="30" HorizontalAlignment="Center"/><TextBlock Text="Volume down"/></StackPanel></Button>
          <Button Style="{StaticResource PanelLightButton}" Tag="{Binding HeadphonesLightOn}" Background="White" Foreground="#17202A" Command="{Binding ConsoleActionCommand}" CommandParameter="PANEL_8"><StackPanel><TextBlock Text="🔇" FontFamily="Segoe UI Emoji" FontSize="23" HorizontalAlignment="Center"/><TextBlock Text="Mute speakers"/></StackPanel></Button>
          <Button Style="{StaticResource PanelLightButton}" Tag="{Binding VolumeUpLightOn}" Background="White" Foreground="#17202A" Command="{Binding ConsoleActionCommand}" CommandParameter="PANEL_2"><StackPanel><TextBlock Text="+" FontSize="30" HorizontalAlignment="Center"/><TextBlock Text="Volume up"/></StackPanel></Button>
          <Button Style="{StaticResource PanelLightButton}" Tag="{Binding VideoLightOn}" Background="#1976D2" Foreground="White" Command="{Binding ConsoleActionCommand}" CommandParameter="PANEL_6"><StackPanel><TextBlock Text="▶" FontSize="25" HorizontalAlignment="Center"/><TextBlock Text="Video"/></StackPanel></Button><Border Background="Transparent" Width="100" Height="74"/>
          <Button Style="{StaticResource PanelLightButton}" Tag="{Binding TvLightOn}" Background="#1976D2" Foreground="White" Command="{Binding ConsoleActionCommand}" CommandParameter="PANEL_5" ToolTip="Short press: TV. Hold: Spotify."><StackPanel><TextBlock Text="TV" FontSize="23" FontWeight="Bold" HorizontalAlignment="Center"/><TextBlock Text="Watch TV"/></StackPanel></Button>
          <Button Background="#FBC02D" Foreground="#17202A" Command="{Binding ConsoleActionCommand}" CommandParameter="PANEL_4"><StackPanel><TextBlock Text="2" FontSize="25" FontWeight="Bold" HorizontalAlignment="Center"/><TextBlock Text="{Binding YvonneDisplayName}"/></StackPanel></Button>
          <Button Style="{StaticResource PanelLightButton}" Tag="{Binding StopLightOn}" Background="#D32F2F" Foreground="White" Command="{Binding ConsoleActionCommand}" CommandParameter="PANEL_7"><StackPanel><TextBlock Text="■" FontSize="25" HorizontalAlignment="Center"/><TextBlock Text="Stop / Home"/></StackPanel></Button>
          <Button Background="#FBC02D" Foreground="#17202A" Command="{Binding ConsoleActionCommand}" CommandParameter="PANEL_3"><StackPanel><TextBlock Text="1" FontSize="25" FontWeight="Bold" HorizontalAlignment="Center"/><TextBlock Text="{Binding AdrianDisplayName}"/></StackPanel></Button>
        </UniformGrid></GroupBox>
        <StackPanel Grid.Column="1"><GroupBox Header="Windows system volume"><StackPanel><TextBlock Text="{Binding VolumePercent, StringFormat={}{0:0}%}" FontSize="36" HorizontalAlignment="Center"/><ProgressBar Value="{Binding VolumePercent, Mode=OneWay}" Maximum="100" Height="20" Margin="5"/><WrapPanel HorizontalAlignment="Center"><Button Content="Volume −" Command="{Binding VolumeDownCommand}"/><Button Content="Volume +" Command="{Binding VolumeUpCommand}"/><Button Content="Mute" Command="{Binding MuteCommand}"/></WrapPanel><TextBlock Text="{Binding Muted, StringFormat=Mute active: {0}}" HorizontalAlignment="Center"/><TextBlock Text="{Binding SystemState, StringFormat=Application state: {0}}" HorizontalAlignment="Center"/></StackPanel></GroupBox><GroupBox Header="Activity and updates"><StackPanel><Button Content="Open activity log folder" Command="{Binding OpenActivityLogCommand}" HorizontalAlignment="Left"/><TextBlock Text="{Binding UpdateStatus}" FontWeight="SemiBold" Margin="4"/><WrapPanel><Button Content="Check for updates" Command="{Binding CheckForUpdatesCommand}"/><Button Content="Install update" Command="{Binding InstallUpdateCommand}" IsEnabled="{Binding CanInstallUpdate}"/></WrapPanel></StackPanel></GroupBox></StackPanel>
      </Grid></ScrollViewer></TabItem>

      <TabItem Header="Media &amp; Calls"><ScrollViewer VerticalScrollBarVisibility="Auto"><Grid Margin="6"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
        <StackPanel><GroupBox Header="Media"><StackPanel><TextBlock Text="TV: YouTube video or live-stream URL" FontWeight="SemiBold"/><TextBox Text="{Binding YouTubeUrl, UpdateSourceTrigger=PropertyChanged}" Margin="4"/><TextBlock Text="Spotify: opened by holding TV" FontWeight="SemiBold" Margin="0,8,0,0"/><TextBox Text="{Binding SpotifyUrl, UpdateSourceTrigger=PropertyChanged}" Margin="4"/><DockPanel Margin="4"><TextBlock Text="Browser" Width="100"/><ComboBox SelectedValue="{Binding PreferredBrowser}" SelectedValuePath="Content" Width="150"><ComboBoxItem Content="Edge"/><ComboBoxItem Content="Chrome"/></ComboBox></DockPanel><TextBlock Text="Video: local file played fullscreen in VLC" FontWeight="SemiBold" Margin="0,8,0,0"/><DockPanel><Button Content="Browse..." Command="{Binding BrowseVideoCommand}"/><TextBox Text="{Binding VideoPath}" Margin="4" IsReadOnly="True"/></DockPanel><CheckBox Content="Stop/Home closes the VLC video" IsChecked="{Binding StopVideoOnHome}" Margin="5"/></StackPanel></GroupBox>
        <GroupBox Header="Audio profiles"><StackPanel><DockPanel Margin="4"><TextBlock Text="Speakers" Width="110"/><ComboBox ItemsSource="{Binding AudioOutputDevices}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding SelectedSpeakerDeviceId}" MinWidth="290"/></DockPanel><DockPanel Margin="4"><TextBlock Text="Headphones" Width="110"/><ComboBox ItemsSource="{Binding AudioOutputDevices}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding SelectedHeadphoneDeviceId}" MinWidth="290"/></DockPanel><DockPanel Margin="4"><TextBlock Text="Speaker mic" Width="110"/><ComboBox ItemsSource="{Binding AudioInputDevices}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding SelectedSpeakerMicrophoneId}" MinWidth="290"/></DockPanel><DockPanel Margin="4"><TextBlock Text="Headphone mic" Width="110"/><ComboBox ItemsSource="{Binding AudioInputDevices}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding SelectedHeadphoneMicrophoneId}" MinWidth="290"/></DockPanel><Button Content="Refresh audio devices" Command="{Binding RefreshAudioDevicesCommand}" HorizontalAlignment="Left"/></StackPanel></GroupBox></StackPanel>
        <StackPanel Grid.Column="1"><GroupBox Header="People and calling"><StackPanel><TextBlock Text="Each person can use Zoom or SIP" FontWeight="SemiBold"/><DockPanel Margin="4"><TextBox Text="{Binding AdrianDisplayName, UpdateSourceTrigger=PropertyChanged}" Width="120"/><ComboBox Width="80" SelectedValue="{Binding AdrianCallMethod}" SelectedValuePath="Content"><ComboBoxItem Content="None"/><ComboBoxItem Content="Zoom"/><ComboBoxItem Content="SIP"/></ComboBox><TextBox Text="{Binding AdrianCallTarget, UpdateSourceTrigger=PropertyChanged}" Margin="4"/></DockPanel><DockPanel Margin="4"><Button Content="Choose photo..." Command="{Binding BrowseAdrianPhotoCommand}"/><TextBox Text="{Binding AdrianPhotoPath}" IsReadOnly="True" Margin="4"/></DockPanel><DockPanel Margin="4"><TextBox Text="{Binding YvonneDisplayName, UpdateSourceTrigger=PropertyChanged}" Width="120"/><ComboBox Width="80" SelectedValue="{Binding YvonneCallMethod}" SelectedValuePath="Content"><ComboBoxItem Content="None"/><ComboBoxItem Content="Zoom"/><ComboBoxItem Content="SIP"/></ComboBox><TextBox Text="{Binding YvonneCallTarget, UpdateSourceTrigger=PropertyChanged}" Margin="4"/></DockPanel><DockPanel Margin="4"><Button Content="Choose photo..." Command="{Binding BrowseYvonnePhotoCommand}"/><TextBox Text="{Binding YvonnePhotoPath}" IsReadOnly="True" Margin="4"/></DockPanel><Button Content="Connect MicroSIP incoming calls" Command="{Binding ConfigureMicroSipCommand}" HorizontalAlignment="Left"/></StackPanel></GroupBox>
        <GroupBox Header="Call quiet hours"><StackPanel><CheckBox Content="Block incoming and outgoing calls" IsChecked="{Binding CallQuietHoursEnabled}" Margin="4"/><WrapPanel Margin="4"><TextBlock Text="From"/><TextBox Text="{Binding CallQuietFrom, UpdateSourceTrigger=PropertyChanged}" Width="58" Margin="6,0,14,0"/><TextBlock Text="Until"/><TextBox Text="{Binding CallQuietUntil, UpdateSourceTrigger=PropertyChanged}" Width="58" Margin="6,0"/></WrapPanel><TextBlock Text="Uses local 24-hour time and may cross midnight." Foreground="#52606D"/></StackPanel></GroupBox></StackPanel>
      </Grid></ScrollViewer></TabItem>

      <TabItem Header="Display &amp; Photos"><ScrollViewer VerticalScrollBarVisibility="Auto"><Grid Margin="6"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
        <GroupBox Header="Screen blackout schedule"><StackPanel><WrapPanel Margin="4"><CheckBox Content="Black out display" IsChecked="{Binding DisplayScheduleEnabled}"/><TextBlock Text="from" Margin="12,0,4,0"/><TextBox Text="{Binding BlackoutFrom, UpdateSourceTrigger=PropertyChanged}" Width="58"/><TextBlock Text="until" Margin="12,0,4,0"/><TextBox Text="{Binding ResumeAt, UpdateSourceTrigger=PropertyChanged}" Width="58"/></WrapPanel><CheckBox Content="Show day/date clock" IsChecked="{Binding ShowBlackoutClock}" Margin="5"/><WrapPanel Margin="4"><TextBlock Text="Clock style" Width="95"/><ComboBox Width="110" SelectedValue="{Binding BlackoutClockStyle}" SelectedValuePath="Content"><ComboBoxItem Content="Digital"/><ComboBoxItem Content="Analogue"/></ComboBox><CheckBox Content="24-hour time" IsChecked="{Binding Use24HourBlackoutClock}" Margin="12,4"/></WrapPanel><DockPanel Margin="4"><TextBlock Text="Date format" Width="95"/><ComboBox Width="230" IsEditable="True" Text="{Binding BlackoutDateFormat, UpdateSourceTrigger=PropertyChanged}"><ComboBoxItem Content="dddd, dd/MM/yyyy"/><ComboBoxItem Content="dddd, MM/dd/yyyy"/><ComboBoxItem Content="dddd, d MMMM yyyy"/></ComboBox></DockPanel><WrapPanel Margin="4"><TextBlock Text="Clock colour" Width="95"/><TextBox Text="{Binding BlackoutClockColor, UpdateSourceTrigger=PropertyChanged}" Width="90"/><Border Width="28" Height="22" Margin="6,0" Background="{Binding BlackoutClockColor}" BorderBrush="#808080" BorderThickness="1"/><Button Content="Choose..." Command="{Binding ChooseBlackoutClockColorCommand}"/></WrapPanel><DockPanel Margin="4"><TextBlock Text="Brightness" Width="95"/><Slider Minimum="1" Maximum="100" Width="180" Value="{Binding BlackoutClockBrightness}"/><TextBlock Text="{Binding BlackoutClockBrightness, StringFormat={}{0:0}%}" Margin="8,0"/></DockPanel><DockPanel Margin="4"><TextBlock Text="Instruction" Width="95"/><TextBox Text="{Binding BlackoutWakePrompt, UpdateSourceTrigger=PropertyChanged}" MaxLength="80"/></DockPanel><DockPanel Margin="4"><TextBlock Text="Long press" Width="95"/><Slider Minimum="500" Maximum="10000" Width="190" TickFrequency="250" IsSnapToTickEnabled="True" Value="{Binding LongPressMilliseconds}"/><TextBlock Text="{Binding LongPressMilliseconds, StringFormat={}{0:0} ms}" Margin="8,0"/></DockPanel><TextBlock Text="A keyboard key, mouse button or console button wakes the screen. Mouse movement alone does not." Foreground="#52606D" TextWrapping="Wrap"/></StackPanel></GroupBox>
        <GroupBox Grid.Column="1" Header="Google Drive photo wallpaper"><StackPanel><CheckBox Content="Cycle through photos from the latest capture day" IsChecked="{Binding WallpaperEnabled}" Margin="5"/><DockPanel Margin="4"><Button Content="Choose Drive folder..." Command="{Binding BrowseWallpaperFolderCommand}"/><TextBox Text="{Binding WallpaperSourceFolder}" Margin="4" IsReadOnly="True"/></DockPanel><WrapPanel Margin="4"><TextBlock Text="Change every" Width="90"/><TextBox Text="{Binding WallpaperRotationMinutes, UpdateSourceTrigger=PropertyChanged}" Width="55"/><TextBlock Text="minutes" Margin="6,0,12,0"/><CheckBox Content="Include subfolders" IsChecked="{Binding WallpaperIncludeSubfolders}"/></WrapPanel><CheckBox Content="Show day, date and time" IsChecked="{Binding WallpaperShowCaptureDate}" Margin="4"/><CheckBox Content="Show suburb and map when GPS is available" IsChecked="{Binding WallpaperShowLocation}" Margin="4"/><DockPanel Margin="4"><TextBlock Text="Date format" Width="90"/><ComboBox Width="220" IsEditable="True" Text="{Binding WallpaperDateFormat, UpdateSourceTrigger=PropertyChanged}"><ComboBoxItem Content="dd MMMM yyyy"/><ComboBoxItem Content="dd/MM/yyyy"/><ComboBoxItem Content="MM/dd/yyyy"/></ComboBox></DockPanel><DockPanel Margin="4"><TextBlock Text="Time format" Width="90"/><ComboBox Width="220" IsEditable="True" Text="{Binding WallpaperTimeFormat, UpdateSourceTrigger=PropertyChanged}"><ComboBoxItem Content="h:mm tt"/><ComboBoxItem Content="HH:mm"/></ComboBox></DockPanel><WrapPanel><Button Content="Refresh photos" Command="{Binding RefreshWallpaperCommand}"/><Button Content="Show next now" Command="{Binding NextWallpaperCommand}"/></WrapPanel><TextBlock Text="{Binding WallpaperStatus}" Foreground="#1769AA" TextWrapping="Wrap" Margin="4"/><TextBlock Text="Use a mirrored or offline-available Google Drive folder. New files are detected automatically. Maps and suburb names are cached for offline reuse. Only the newest capture date is rotated." Foreground="#52606D" TextWrapping="Wrap"/></StackPanel></GroupBox>
      </Grid></ScrollViewer></TabItem>

      <TabItem Header="Apps &amp; System"><ScrollViewer VerticalScrollBarVisibility="Auto"><Grid Margin="6"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
        <GroupBox Header="Required applications"><StackPanel><TextBlock Text="Install uses the trusted Windows Package Manager source." Foreground="#52606D"/><ItemsControl ItemsSource="{Binding Applications}"><ItemsControl.ItemTemplate><DataTemplate><Grid Margin="2"><Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock Grid.Column="1" Text="{Binding Detail}" TextTrimming="CharacterEllipsis"/><Button Grid.Column="2" Content="Install" IsEnabled="{Binding CanInstall}" Command="{Binding DataContext.InstallApplicationCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding Key}"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><Button Content="Check again" Command="{Binding RefreshApplicationsCommand}" HorizontalAlignment="Left"/></StackPanel></GroupBox>
        <StackPanel Grid.Column="1"><GroupBox Header="Windows startup"><StackPanel><CheckBox Content="Start automatically after Windows sign-in" IsChecked="{Binding StartWithWindows}" Margin="5"/><CheckBox Content="Appliance session protection" IsChecked="{Binding ProtectSession}" Margin="5"/><Button Content="Configure automatic Windows sign-in..." Command="{Binding ConfigureAutoLogonCommand}" HorizontalAlignment="Left"/><TextBlock Text="Automatic sign-in gives anyone with physical access use of this account. Passwords are handled by Microsoft's Autologon tool." Foreground="#8A3B12" TextWrapping="Wrap"/></StackPanel></GroupBox><GroupBox Header="Settings backup"><TextBlock Text="Use the Save, Export and Import buttons along the bottom. Exported JSON includes settings and paths, but does not copy media or photographs." Foreground="#52606D" TextWrapping="Wrap"/></GroupBox></StackPanel>
      </Grid></ScrollViewer></TabItem>

      <TabItem Header="Controller"><ScrollViewer VerticalScrollBarVisibility="Auto"><Grid Margin="6"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
        <GroupBox Header="Arduino connection"><StackPanel><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions><TextBlock Text="Detected port"/><TextBlock Grid.Column="1" Text="{Binding Port}" FontWeight="Bold"/><TextBlock Grid.Row="1" Text="Firmware"/><TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Firmware}"/><TextBlock Grid.Row="2" Text="Protocol"/><TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Protocol}"/><TextBlock Grid.Row="3" Text="Controller uptime"/><TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Uptime}"/><TextBlock Grid.Row="4" Text="Last heartbeat"/><TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding Heartbeat}"/><TextBlock Grid.Row="5" Text="Communication errors"/><TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding CommunicationErrors}"/><TextBlock Grid.Row="6" Text="Last message"/><TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding LastMessage}" TextWrapping="Wrap"/></Grid><Separator Margin="0,8"/><TextBlock Text="{Binding FirmwareUpdateStatus}" TextWrapping="Wrap"/><Button Content="Update controller firmware" Command="{Binding UpdateControllerFirmwareCommand}" HorizontalAlignment="Left"/></StackPanel></GroupBox>
        <StackPanel Grid.Column="1"><GroupBox Header="Live inputs"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions><TextBlock Text="Ambient light (raw)"/><TextBlock Grid.Column="1" Text="{Binding AmbientLight}"/><TextBlock Grid.Row="1" Text="Microphone level (smoothed)"/><TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Microphone}"/></Grid></GroupBox><GroupBox Header="Controller identity"><StackPanel><TextBlock Text="{Binding PanelHardware}" FontWeight="SemiBold"/><TextBlock Text="The controller is discovered by DCB/1 handshake. COM numbers are never stored as identity." Foreground="#52606D" TextWrapping="Wrap"/></StackPanel></GroupBox></StackPanel>
      </Grid></ScrollViewer></TabItem>

      <TabItem Header="Hardware Tests"><ScrollViewer VerticalScrollBarVisibility="Auto"><Grid Margin="6"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
        <StackPanel><GroupBox Header="Addressable RGB LEDs (0 to 255)"><StackPanel><TextBlock Text="RGB LED 1" FontWeight="Bold"/><WrapPanel><TextBlock Text="R"/><Slider Width="95" Maximum="255" Value="{Binding Rgb1Red}"/><TextBlock Text="G"/><Slider Width="95" Maximum="255" Value="{Binding Rgb1Green}"/><TextBlock Text="B"/><Slider Width="95" Maximum="255" Value="{Binding Rgb1Blue}"/><Button Content="Set" Command="{Binding SetRgb1Command}"/></WrapPanel><TextBlock Text="RGB LED 2" FontWeight="Bold" Margin="0,8,0,0"/><WrapPanel><TextBlock Text="R"/><Slider Width="95" Maximum="255" Value="{Binding Rgb2Red}"/><TextBlock Text="G"/><Slider Width="95" Maximum="255" Value="{Binding Rgb2Green}"/><TextBlock Text="B"/><Slider Width="95" Maximum="255" Value="{Binding Rgb2Blue}"/><Button Content="Set" Command="{Binding SetRgb2Command}"/></WrapPanel></StackPanel></GroupBox><GroupBox Header="16 x 8 matrix and buzzer"><StackPanel><WrapPanel><Button Content="Clear" Command="{Binding MatrixClearCommand}"/><Button Content="Test pattern" Command="{Binding MatrixPatternCommand}"/><Button Content="OK icon" Command="{Binding MatrixOkCommand}"/><Button Content="X icon" Command="{Binding MatrixXCommand}"/></WrapPanel><WrapPanel><TextBox Text="{Binding MatrixText, UpdateSourceTrigger=PropertyChanged}" Width="90" MaxLength="2" Margin="4"/><Button Content="Show text" Command="{Binding MatrixTextCommand}"/><Button Content="Short buzzer test" Command="{Binding BuzzerCommand}"/></WrapPanel></StackPanel></GroupBox></StackPanel>
        <StackPanel Grid.Column="1"><GroupBox Header="Direct panel: 8 buttons / 6 on-off LEDs"><StackPanel><ItemsControl ItemsSource="{Binding PanelButtons}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Border BorderBrush="#CCD3DA" BorderThickness="1" Margin="2" Padding="4"><StackPanel Width="92"><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock Text="{Binding State}"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><ItemsControl ItemsSource="{Binding PanelLeds}" Margin="0,6"><ItemsControl.ItemTemplate><DataTemplate><DockPanel><TextBlock Text="{Binding Name}" Width="130"/><Button Content="On" Command="{Binding OnCommand}"/><Button Content="Off" Command="{Binding OffCommand}"/></DockPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><Button Content="All panel LEDs off" Command="{Binding PanelAllOffCommand}" HorizontalAlignment="Left"/><DockPanel Margin="4"><TextBlock Text="Overall brightness" Width="130"/><Slider Width="180" Minimum="0" Maximum="100" Value="{Binding PanelBrightness}"/><Button Content="Set" Command="{Binding SetPanelBrightnessCommand}"/></DockPanel></StackPanel></GroupBox><GroupBox Header="Hardware self-test"><StackPanel><Button Content="RUN HARDWARE SELF TEST" Command="{Binding RunSelfTestCommand}" Background="#1769AA" Foreground="White" FontWeight="Bold"/><DataGrid ItemsSource="{Binding SelfTestResults}" AutoGenerateColumns="False" IsReadOnly="True" Height="220" Margin="4"><DataGrid.Columns><DataGridTextColumn Header="Item" Binding="{Binding Item}" Width="130"/><DataGridTextColumn Header="Result" Binding="{Binding Status}" Width="70"/><DataGridTextColumn Header="Detail" Binding="{Binding Detail}" Width="*"/></DataGrid.Columns></DataGrid></StackPanel></GroupBox></StackPanel>
      </Grid></ScrollViewer></TabItem>
    </TabControl>
    <Border Grid.Row="2" Background="#E6EBF0" CornerRadius="5" Padding="6" Margin="6"><DockPanel><TextBlock Text="Settings are stored locally and can be exported as JSON." Foreground="#52606D" Margin="6"/><WrapPanel DockPanel.Dock="Right"><Button Content="Save settings" Command="{Binding SaveContentCommand}"/><Button Content="Export..." Command="{Binding ExportSettingsCommand}"/><Button Content="Import..." Command="{Binding ImportSettingsCommand}"/></WrapPanel></DockPanel></Border>
  </Grid>
</Window>
